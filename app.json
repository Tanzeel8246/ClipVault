{
  "expo": {
    "name": "ClipVault",
    "slug": "clipvault",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clipvault",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clipvault.mobile"
    },
    "android": {
      "package": "com.clipvault.mobile",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080810"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080810"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
